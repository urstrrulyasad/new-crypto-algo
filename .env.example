# Copy to .env and fill in real values before running docker compose.
# For GCP + Supabase, use .env.gcp.example → .env.gcp with docker-compose.gcp.yml instead.
DB_PASSWORD=crypto
DB_SSL_MODE=disable
# base64 of 32+ random bytes, e.g.: openssl rand -base64 48
JWT_SECRET=
# base64 of exactly 32 random bytes, e.g.: openssl rand -base64 32
MASTER_KEY=
# any long random string shared between backend and strategy-engine
INTERNAL_TOKEN=
SUPERADMIN_EMAIL=admin@platform.local
SUPERADMIN_PASSWORD=
CORS_ORIGINS=http://localhost
# Production frontend example:
# CORS_ORIGINS=https://new-crypto-algo-eight.vercel.app
