# Copy to .env.gcp on the GCP VM (never commit .env.gcp).
# Frontend: https://new-crypto-algo-eight.vercel.app

# --- Supabase Postgres (use IPv4 pooler from EC2; direct db.* host is IPv6-only) ---
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.cdrsogeidbkjaapnjpbp
DB_PASSWORD=
DB_SCHEMA=quantdcx
DB_SSL_MODE=require

# --- Auth / crypto (generate strong values) ---
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32
MASTER_KEY=
# openssl rand -hex 32
INTERNAL_TOKEN=

SUPERADMIN_EMAIL=admin@platform.local
SUPERADMIN_PASSWORD=

# Exact Vercel origin (comma-separated if multiple)
CORS_ORIGINS=https://new-crypto-algo-eight.vercel.app

SIGNAL_POLL_SECONDS=60
# Up to N complementary strategies per coin (MR / Trend / Breakout)
PIPELINE_MAX_STRATEGIES_PER_INSTRUMENT=3

# --- Deploy (managed by GitHub Actions; do not edit by hand) ---
# The deploy workflows upsert these into .env.gcp so Compose pulls the exact
# SHA-pinned GHCR images. GHCR_OWNER = lowercase repo owner; tags = git commit SHA.
GHCR_OWNER=
BACKEND_TAG=latest
STRATEGY_ENGINE_TAG=latest


